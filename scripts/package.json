{
  "name": "excalidraw-skill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Excalidraw skill: headless render-and-check from skeleton JSON, plus a browser editor that auto-saves",
  "scripts": {
    "build": "esbuild web/app.tsx --bundle --format=esm --minify --conditions=production --define:process.env.NODE_ENV='\"production\"' --define:process.env.IS_PREACT='\"false\"' --loader:.woff2=file --outdir=web/dist --log-level=warning",
    "check": "tsc --noEmit -p .",
    "selftest": "node --disable-warning=ExperimentalWarning selftest.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
